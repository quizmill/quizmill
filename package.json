{
  "name": "quizmill",
  "version": "0.0.0-dev",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "tsx scripts/ensure-pack.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/ensure-pack.ts",
    "build": "next build --webpack",
    "postbuild": "tsx scripts/finalise-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pack:validate": "tsx tools/pack/validate.ts",
    "pack:bundle": "tsx tools/pack/bundle.ts",
    "pack:use": "tsx scripts/use-pack.ts",
    "pack:list": "tsx scripts/list-packs.ts",
    "sync:report": "tsx cloudflare/scripts/events-report.ts",
    "pretest": "tsx scripts/ensure-pack.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NEXT_PUBLIC_BASE_PATH= npm run build && vitest run --config vitest.e2e.config.mts",
    "test:e2e:watch": "E2E_HEADED=1 npm run test:e2e"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "happy-dom": "^20.14.6",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.29",
    "puppeteer": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.0.3"
  }
}
