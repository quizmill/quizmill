node_modules/
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# logs
*.log
npm-debug.log*

# editor
.vscode/
.idea/
.DS_Store

# Claude Code git worktrees (committed .claude/ settings & skills stay tracked)
/.claude/worktrees/

# env
.env*.local
.env

# vitest cache
.vitest-cache/

# Learning packs are PRIVATE by default.
# content/pack/ is the ACTIVE pack (seeded from content/pack-demo by
# scripts/ensure-pack.ts, swapped by `npm run pack:use`); packs/ is the
# authoring workspace for your own packs.
/content/pack/
/packs/
# one-file pack hand-overs written by `quizmill bundle` / npm run pack:bundle
*.bundle.json
# generated from the active pack's manifest by scripts/pack-assets.ts
/public/manifest.webmanifest
/public/icon.svg
/public/icon-maskable.svg
/public/apple-touch-icon.png
# mirrored from the active pack's assets/ by scripts/pack-assets.ts
/public/pack-assets/

# wrangler local dev state (cloudflare/ worker)
.wrangler/

# review screenshots are attached to the PR, never committed (see CLAUDE.md)
/docs/screenshots/

# Playwright reports and traces
/playwright-report/
/test-results/
cloudflare/.dev.vars
